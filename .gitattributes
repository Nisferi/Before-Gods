# Normalize line endings to LF for all text files
* text=auto eol=lf

# Godot text formats - always LF
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.gdshader text eol=lf
*.import text eol=lf

# Godot binary formats - treat as binary (no diff, no merge)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.svg text eol=lf
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Export / build artifacts
*.pck binary
*.apk binary
*.aab binary
*.exe binary

# Documents
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
